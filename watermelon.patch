-def _aligned_returns(stock: pd.DataFrame, benchmark: pd.DataFrame) -> pd.DataFrame:
-    joined = pd.concat(
-        [stock["close"].pct_change().rename("stock"), benchmark["close"].pct_change().rename("market")],
-        axis=1,
-        join="inner",
-    ).dropna()
-    return joined
-
